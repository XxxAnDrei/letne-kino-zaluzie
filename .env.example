# Skopíruj do .env a vyplň. Súbor .env sa do gitu nedostane.

# Heslo do správcovského panela na /spravca.
# Ak ho nenastavíš, server si pri štarte vygeneruje dočasné a vypíše ho do konzoly.
ADMIN_PASSWORD=zmen-ma-na-nieco-dlhe

# Podpisuje prihlasovaciu cookie. Vygeneruj napr.:  openssl rand -hex 32
# Bez neho sa po každom reštarte servera odhlásiš.
SESSION_SECRET=

# --- Databáza ---------------------------------------------------------------
# Server si vyberie podľa toho, čo je vyplnené:
#   1. DATABASE_URL začínajúce na postgres://  → Supabase (alebo iný Postgres)
#   2. TURSO_DATABASE_URL                      → Turso
#   3. nič z toho                              → lokálny súbor v DATA_DIR
#
# Pri vývoji nechaj oboje prázdne. Na Verceli vyplň jedno z nich, inak by sa
# rezervácie po každom nasadení stratili — serverless funkcia nemá trvalý disk.

# Supabase: Project Settings → Database → Connection string → Transaction pooler.
# Použi adresu s portom 6543 (Supavisor v transakčnom režime), nie 5432.
# Heslo v adrese musí byť URL-enkódované, ak obsahuje zvláštne znaky.
DATABASE_URL=

# Turso, ak nechceš Supabase.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Kam sa ukladá lokálna databáza, keď nie je nastavená ani jedna z nich.
DATA_DIR=./data

# --- E-maily -----------------------------------------------------------------
# Posiela sa cez Brevo, HTTP API (nie SMTP — serverless funkcia nemá kedy držať
# otvorené spojenie). Kľúč: Brevo → SMTP & API → API Keys, začína na "xkeysib-".
# Bez kľúča alebo bez MAIL_FROM sa e-maily jednoducho neposielajú; rezervácie
# fungujú ďalej a dôvod sa zapíše do logu.
BREVO_API_KEY=

# Adresa odosielateľa. Musí byť v Breve overená ako sender, inak Brevo odmietne.
MAIL_FROM=
MAIL_FROM_NAME=Letné kino Veľké Zálužie

# Kam chodia upozornenia o nových žiadostiach.
MAIL_ADMIN=

# Nepovinné: adresa pre odpoveď, keď sa odosiela z inej než čítanej schránky.
MAIL_REPLY_TO=

# Verejná adresa stránky. Doplní absolútne odkazy do e-mailov a do náhľadu
# pri zdieľaní. Na Verceli sa berie z VERCEL_PROJECT_PRODUCTION_URL, netreba ju.
SITE_URL=

# Port, na ktorom server počúva. Na Verceli sa ignoruje.
PORT=3000

# Nastav na "production" pri nasadení — zapne secure cookie (vyžaduje HTTPS).
NODE_ENV=production

# Koľko proxy vrstiev je pred aplikáciou. Vercel/Render/Railway = 1, priamy beh = 0.
# Ovplyvňuje to, akú IP vidí obmedzovač počtu žiadostí.
TRUST_PROXY_HOPS=1
